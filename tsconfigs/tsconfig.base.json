{
    "compilerOptions": {
        "rootDir": "../src",
        "module": "esnext",
        "moduleResolution": "bundler",
        "declaration": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noImplicitThis": true,
        "noImplicitReturns": true,
        "alwaysStrict": true,
        "strictBindCallApply": true,
        "strictNullChecks": true
    },
    "include": ["../src"]
}